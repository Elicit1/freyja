#   datasource:
#     url: jdbc:mysql://172.23.125.51:3306/freyja?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
#     username: root
#     password: root
#   data:
#     redis:
#       host: 172.23.125.51
#       port: 6379
#       password: 123456

# freyja:
#   media-tools:
#     ffmpeg-path: F:\program_file\ffmpeg\bin\ffmpeg.exe
#     ffprobe-path: F:\program_file\ffmpeg\bin\ffprobe.exe

