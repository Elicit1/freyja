COMFY_URL=http://100.81.173.100:8188
# First boot only. Leave blank to generate an initial administrator password in the startup log.
# Change it after login at http://127.0.0.1:8011/. API keys are created in the console.
SIF_ADMIN_PASSWORD=
IMAGE_HOST=127.0.0.1
IMAGE_PORT=8011
# Optional absolute URL used in generated image links. Otherwise uses the request origin.
IMAGE_PUBLIC_BASE_URL=
IMAGE_TIMEOUT_SECONDS=1800
# Server-side MinIO storage credentials. Uploaded references expire after 24 hours.
SIF_MINIO_ENDPOINT=
# Client-reachable origin used for returned image URLs.
SIF_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
SIF_MINIO_ACCESS_KEY=
SIF_MINIO_SECRET_KEY=
SIF_MINIO_BUCKET=sif-uploads
# Existing FREYJA asset buckets may be used as reference sources.
SIF_MINIO_READ_BUCKETS=video-assets
SIF_MINIO_URL_ALIASES=http://minio.localhost:9000,http://localhost:9000
# Optional host-specific directory for native Python execution only:
# IMAGE_SERVICE_HOME=F:/your/path/comfy_image_service
