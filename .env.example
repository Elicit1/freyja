# ==============================================================================
# Freyja 环境变量配置模板 (.env)
# 复制本文件为 .env 即可根据实际环境微调配置：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 外部算力端 (ComfyUI / GPU 主机配置)
# ------------------------------------------------------------------------------
# 若 ComfyUI 运行在当前电脑 (Windows 或 Linux 本机)：使用 host.docker.internal 访问
# 若 ComfyUI 运行在局域网其它机器或独立 GPU 服务器：填入对应 IP 与端口，如 http://192.168.1.100:8188
COMFYUI_HTTP_URL=http://host.docker.internal:8188
COMFYUI_WS_URL=ws://host.docker.internal:8188/ws

# ------------------------------------------------------------------------------
# 2. 核心服务暴露端口 (如冲突可自由修改)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8080
GATEWAY_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. 密码与安全密钥 (开源部署请在生产环境修改密码)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=123456
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# 后端 API 密钥加密私钥 (AES 32字节安全秘钥，生产环境请务必更换为随机字符串)
FREYJA_CRYPTO_KEY=freyja-production-secret-key-32bytes

# ------------------------------------------------------------------------------
# 4. 浏览器访问地址 (MinIO 外部预览与下载端点)
# ------------------------------------------------------------------------------
# 若在云服务器上部署，请将 localhost 改为您的服务器公网 IP 或域名
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
GATEWAY_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. JVM 运行参数
# ------------------------------------------------------------------------------
BACKEND_JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC
