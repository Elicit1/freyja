# ==============================================================================
# Freyja 环境变量配置模板 (.env)
# 复制本文件为 .env 即可根据实际环境微调配置：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. 系统版本与发布配置 (Release Version)
# ------------------------------------------------------------------------------
FREYJA_VERSION=1.0.0
# IMAGE_PREFIX=astrag1/

# ------------------------------------------------------------------------------
# 1. 外部算力端 (ComfyUI / GPU 主机配置)
# ------------------------------------------------------------------------------
# 若 ComfyUI 运行在当前电脑 (Windows 或 Linux 本机)：使用 host.docker.internal 访问
# 若 ComfyUI 运行在局域网其它机器或独立 GPU 服务器：填入对应 IP 与端口，如 http://192.168.1.100:8188
COMFYUI_HTTP_URL=http://host.docker.internal:8188
COMFYUI_WS_URL=ws://host.docker.internal:8188/ws

# ------------------------------------------------------------------------------
# 2. 核心服务暴露端口 (如冲突可自由修改)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8080
GATEWAY_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. 密码与安全密钥 (开源部署请在生产环境修改密码)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=123456
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# 后端 API 密钥加密私钥 (AES 32字节安全秘钥，生产环境请务必更换为随机字符串)
FREYJA_CRYPTO_KEY=freyja-production-secret-key-32bytes

# ------------------------------------------------------------------------------
# 4. 浏览器访问地址 (MinIO 外部预览与下载端点)
# ------------------------------------------------------------------------------
# 本机部署使用 minio.localhost：浏览器解析到本机，容器通过 extra_hosts 解析到 Docker 宿主网关。
# 远程部署时改为浏览器和 comfy-gateway 容器都能访问的域名。
MINIO_EXTERNAL_ENDPOINT=http://minio.localhost:9000
# MCP 图片直传：填写运行 Codex/Qoder 等客户端的机器能访问的 MinIO S3 API 地址。
# 本机客户端用回环 IP，避免 minio.localhost 在 PowerShell/.NET 中解析失败或被代理转发。
# 远程客户端必须改成服务器的可访问 IP/域名；不是 Docker 服务名，也不是 9001 控制台端口。
# 修改 MINIO_API_PORT 时同步修改此处端口。留空兼容使用 MINIO_EXTERNAL_ENDPOINT；两者都未设置时使用回环 IP 和发布端口。
MINIO_MCP_UPLOAD_ENDPOINT=http://127.0.0.1:9000
# MCP 预签名直传专用私有暂存桶，应用自动配置一天过期；不能与正式媒体桶同名。
MINIO_MCP_UPLOAD_BUCKET=freyja-mcp-uploads
GATEWAY_BASE_URL=http://localhost:8000
# Hosts allowed to serve immutable reference clips to the gateway (comma-separated, no scheme/port).
# Docker backend signs clips using the internal MinIO endpoint.
REFERENCE_MEDIA_HOSTS=minio

# ------------------------------------------------------------------------------
# 5. JVM 运行参数
# ------------------------------------------------------------------------------
BACKEND_JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC

# ------------------------------------------------------------------------------
# 6. 构建加速配置 (可选，启动脚本已默认通过系统时区静默嗅探)
# ------------------------------------------------------------------------------
# MAINLAND=true

# MCP 首次默认值：默认关闭。可在管理 → MCP 服务配置令牌、权限及整体/工具热开关；页面保存后以持久化配置为准。
FREYJA_MCP_ENABLED=false
FREYJA_MCP_TOKEN=
FREYJA_MCP_WRITE_ENABLED=false
FREYJA_MCP_ALLOW_ALL_PROJECTS=false
FREYJA_MCP_ALLOW_CREATE_PROJECTS=false
# 多个业务 ID 以英文逗号分隔；保持 19 位 ID 原样。
FREYJA_MCP_ALLOWED_PROJECT_IDS=
# 原生桌面客户端无需 Origin；浏览器调用时填明确允许的 Origin，多个以逗号分隔。
FREYJA_MCP_ALLOWED_ORIGINS=

